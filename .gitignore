# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Vite / test caches
.vite/
coverage/

# ZK circuit artifacts (issue #6). Binaries are NOT committed — they're fetched from a hosted release
# (Cloudflare R2 / relayer VPS) at runtime, integrity-verified against src/config/circuits.manifest.json,
# or populated locally with `npm run circuits:fetch`. The manifest itself IS committed (the integrity
# anchor). `.gitkeep` preserves the directory.
public/artifacts/*
!public/artifacts/.gitkeep

# Build-time-fetched Sepolia manifests (Netlify/Vercel pull these from armada-deployments at build
# time per netlify.toml / vercel.json; never commit them).
public/api/

# Environment / personal dev overrides (copy from .env.example). .env.example itself stays tracked.
.env
*.env
.env.local
.env.*.local
.env.development

# Logs
*.log

# Secrets and credentials
*.key
*.pem
*.secret
*.wallet
*.keystore
*.wallet.json

# OS
.DS_Store
._*
*.swp
Thumbs.db
